# ============================================================
#  CESEPEF — Variables d'environnement PRODUCTION
#  Copier ce fichier en .env.production et remplir les valeurs
# ============================================================

# --- Base de données SQLite ----------------------------------
# Chemin absolu recommandé sur le serveur :
# DATABASE_URL="file:/home/VOTRE_USER/cesepef/prisma/prod.db"
DATABASE_URL="file:./prisma/prod.db"

# --- URL publique du site ------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.cesepef.org"

# --- Node.js -------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
