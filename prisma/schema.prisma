generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Authentification ───────────────────────────────────────────────────────

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Équipe ─────────────────────────────────────────────────────────────────

model TeamMember {
  id          Int      @id @default(autoincrement())
  name        String
  role        String
  department  String?
  bio         String?
  photo       String?
  email       String?
  linkedin    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Publications (Blog) ─────────────────────────────────────────────────────

model Publication {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  tags        String?  // JSON array stringifié
  author      String   @default("CESEPEF")
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Services / Offres ───────────────────────────────────────────────────────

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  cible       String?
  delai       String?
  livrables   String?  // JSON array stringifié
  icon        String?
  highlight   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Réalisations / Missions ─────────────────────────────────────────────────

model Realisation {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  client      String?
  sector      String?
  country     String   @default("Tchad")
  year        Int?
  image       String?
  tags        String?  // JSON array stringifié
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Partenaires ────────────────────────────────────────────────────────────

model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String?
  website   String?
  category  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Messages Contact ────────────────────────────────────────────────────────

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  service   String?
  message   String
  isRead    Boolean  @default(false)
  isStarred Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Paramètres Site ────────────────────────────────────────────────────────

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String?
  group     String?
  updatedAt DateTime @updatedAt
}
